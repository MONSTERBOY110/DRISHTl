# Backend Server Configuration
PORT=8000
HOST=0.0.0.0
DEBUG=False

# Database Configuration
DATABASE_URL=sqlite:///./dristi.db

# Face Recognition
FACE_RECOGNITION_MODEL=hog
FACE_MATCH_TOLERANCE=0.6

# Video Processing
VIDEO_FRAME_RATE=30
VIDEO_SCALE=0.5

# Search Service
SEARCH_TIMEOUT=300
MAX_RESULTS=50

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
